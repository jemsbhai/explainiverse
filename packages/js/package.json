{
  "name": "explainiverse-js-experimental",
  "version": "0.0.0-experimental",
  "private": true,
  "description": "Private experimental TypeScript core contracts and attribution visualizer for Explainiverse",
  "explainiverseCapability": {
    "claimStatus": "experimental",
    "wireSchema": "explainiverse.explanation.v1",
    "algorithmParityWithPython": false,
    "publicationReady": false
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "require": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./visualizer": {
      "types": "./dist/visualizer/index.d.ts",
      "require": "./dist/visualizer/index.js",
      "default": "./dist/visualizer/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/core",
    "dist/visualizer",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json",
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint src tests --max-warnings=0",
    "dev": "vite",
    "build:demo": "npm run typecheck && vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:package-boundary": "node scripts/check-package-boundary.mjs",
    "preview:demo": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:browser": "npm run build:demo && npm run check:bundle && playwright test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.50.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
