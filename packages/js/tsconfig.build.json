{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "declaration": true
  },
  "include": [
    "src/index.ts",
    "src/core/**/*.ts",
    "src/visualizer/**/*.tsx"
  ],
  "exclude": ["src/demo", "src/explainers", "src/metrics", "tests"]
}
